# Data directory (large files, downloaded/generated)
data/
# ...except hand-authored concept-graph source .kif files (training inputs we
# don't want to lose). Trained outputs and generated artefacts stay ignored.
# Pattern: re-include each directory, then re-ignore its contents, then
# re-include the specific source files we want to track.
!data/
!data/concept_graph/
data/concept_graph/*
!data/concept_graph/custom_concepts/
!data/concept_graph/sumo_source/
!data/concept_graph/sumo_patches/
!data/concept_graph/persona_concepts.kif
!data/concept_graph/custom_sumo_concepts.kif
data/concept_graph/custom_concepts/*
!data/concept_graph/custom_concepts/*.kif
!data/concept_graph/custom_concepts/README.md
data/concept_graph/sumo_source/*
!data/concept_graph/sumo_source/*.kif
data/concept_graph/sumo_patches/*
!data/concept_graph/sumo_patches/*.kif
!data/concept_graph/sumo_patches/README.md

# Model files
models/*
!models/.gitkeep
!hatstand/app/models/
!hatstand/app/models/**
*.pt
*.pth
*.bin
*.h5
*.hdf5

# Training outputs
sumo_classifiers_adaptive/
sumo_classifiers/

# Logs (exclude from repo, too verbose)
logs/
*.log
wandb/

# Results: Exclude large binary files but keep documentation and small outputs
results/**/*.pt
results/**/*.pth
results/**/*.bin
results/**/*.h5
results/**/*.hdf5
results/**/*.npy
results/**/*.npz
results/**/*.pkl
results/**/*.pickle
results/**/*.joblib
results/**/*.zip
results/**/classifiers/
results/**/checkpoints/
results/**/text_probes/
results/**/activation_probes/

# Results: Keep these files (documentation, metrics, plots)
!results/**/*.md
!results/**/*.json
!results/**/*.csv
!results/**/*.txt
!results/**/*.png
!results/**/*.jpg
!results/**/*.svg
!results/**/*.pdf

# Checkpoints (exclude entirely)
checkpoints/

# Jupyter
.ipynb_checkpoints/
*.ipynb

# OS
.DS_Store
Thumbs.db

# Project specific
projectplan.md
.webui_secret_key

# Environment files (may contain secrets)
.env
.env.*
!.env.example

# Probe packs: Keep all

# Concept packs: Keep everything (just metadata)
# (no exclusions needed - they're small)

# Claude Code documentation (keep it)
!.claude/

# Large generated files
**/feature_weights.json

# Large generated results
results/Steering/lens_analysis/
lens_packs/*_calibration-test/

# ======================================================================
# Pack directories - managed by MAP registry, synced from HuggingFace
# ======================================================================

# Lens packs (model-specific classifiers) - download from HF
lens_packs/
!lens_packs/.registry.json

# Concept packs (ontology definitions) - download from HF
concept_packs/
!concept_packs/.registry.json

# Downloaded/cached models
models/
!hatstand/app/models/
!hatstand/app/models/**


# Results directories (keep structure, exclude large files)
results/temporal_tests/
results/steering_tests/
results/behavioral_eval*/
results/deception_steering*/
results/all_layers_test/
results/steering_comparison*/

# Additional exclusions for public repo
node_modules/
.claude/
results/

# Only first-light concept pack is public
concept_packs/*
!concept_packs/first-light/
